[1.33, "o", "\r\n"]
[2.53, "o", ">>> 1/2: a clean WordPress-shaped site\r\n"]
[2.59, "o", "\u001b[1mphp2shell-ioc 1.0.0\u001b[0m  (CVE-2026-109618 / CVE-2026-109619)\r"]
[2.65, "o", "\r\n"]
[2.71, "o", "host: 3bc88443eb0e   user: root   date: 2026-10-22 16:23 UTC   window: since 2026-10-01 (22 days)\r"]
[2.77, "o", "\r\n"]
[2.83, "o", "  \u001b[34m[info]\u001b[0m running inside a container. If it was recreated after the patch, logs, /tmp\r"]
[2.89, "o", "\r\n"]
[2.95, "o", "  \u001b[34m[info]\u001b[0m and file-based sessions from before the patch are gone. Check the image's\r"]
[3.01, "o", "\r\n"]
[3.07, "o", "  \u001b[34m[info]\u001b[0m persistent volumes and your edge/proxy logs as well.\r"]
[3.13, "o", "\r\n"]
[3.19, "o", "\r"]
[3.25, "o", "\r\n"]
[3.85, "o", "\u001b[1m== 1. PHP runtime ==\u001b[0m\r"]
[3.91, "o", "\r\n"]
[3.97, "o", "  \u001b[34m[info]\u001b[0m no PHP binary found here. If PHP runs in a container, run this inside it.\r"]
[4.03, "o", "\r\n"]
[4.09, "o", "\r"]
[4.15, "o", "\r\n"]
[4.75, "o", "\u001b[1m== 2. Logs ==\u001b[0m\r"]
[4.81, "o", "\r\n"]
[4.87, "o", "  \u001b[34m[info]\u001b[0m no log files found. In containers, pipe them in: docker logs C 2>&1 | sh php2shell-ioc.sh --only logs --log -\r"]
[4.93, "o", "\r\n"]
[4.99, "o", "\r"]
[5.05, "o", "\r\n"]
[5.65, "o", "\u001b[1m== 3. Sessions ==\u001b[0m\r"]
[5.71, "o", "\r\n"]
[5.77, "o", "  \u001b[34m[info]\u001b[0m /tmp: no PHP session files\r"]
[5.83, "o", "\r\n"]
[5.89, "o", "  \u001b[34m[info]\u001b[0m /var/tmp: no PHP session files\r"]
[5.95, "o", "\r\n"]
[6.01, "o", "\r"]
[6.07, "o", "\r\n"]
[6.67, "o", "\u001b[1m== 4. Files ==\u001b[0m\r"]
[6.73, "o", "\r\n"]
[6.79, "o", "\r"]
[6.85, "o", "\r\n"]
[6.91, "o", "  \u001b[1m/var/www/html\u001b[0m (wordpress)\r"]
[6.97, "o", "\r\n"]
[7.03, "o", "  \u001b[32m[ ok ]\u001b[0m no PHP files in /var/www/html/wp-content/uploads\r"]
[7.09, "o", "\r\n"]
[7.15, "o", "  \u001b[32m[ ok ]\u001b[0m no auto_prepend/handler tricks in .user.ini/.htaccess/php.ini\r"]
[7.21, "o", "\r\n"]
[7.27, "o", "  \u001b[32m[ ok ]\u001b[0m no web-shell content patterns\r"]
[7.33, "o", "\r\n"]
[7.39, "o", "  \u001b[32m[ ok ]\u001b[0m no PHP files modified since 2026-10-01\r"]
[7.45, "o", "\r\n"]
[7.51, "o", "  \u001b[34m[info]\u001b[0m run deliberately, as the site user: wp core verify-checksums; wp plugin verify-checksums --all;\r"]
[7.57, "o", "\r\n"]
[7.63, "o", "  \u001b[34m[info]\u001b[0m   wp user list --role=administrator --fields=ID,user_login,user_registered\r"]
[7.69, "o", "\r\n"]
