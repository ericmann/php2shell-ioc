[7.81, "o", "\r\n"]
[8.41, "o", "\u001b[1m== Verdict ==\u001b[0m\r"]
[8.47, "o", "\r\n"]
[8.53, "o", "  \u001b[32m\u001b[1mClean: no flags or warnings from the checks this script can do.\u001b[0m\r"]
[8.59, "o", "\r\n"]
[8.65, "o", "  Limits: memory disclosure leaves almost nothing on disk; redeployed containers\r"]
[8.71, "o", "\r\n"]
[8.77, "o", "  lose their history; an attacker with root could hide from any on-host check.\r"]
[8.83, "o", "\r\n"]
[8.89, "o", "\r\n"]
